<Window x:Class="CodexProjectLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Codex Project Launcher"
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#12151A">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#5CA6FF">
                        <TextBlock Text="C"
                                   Foreground="#07111D"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Codex Project Launcher"
                               Margin="11,0,0,0"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="⚙"
                            ToolTip="Settings"
                            Width="42"
                            Height="58"
                            FontSize="16"
                            Style="{StaticResource WindowControlButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="SettingsButton_Click" />
                    <Button Content="─"
                            ToolTip="Minimize"
                            Style="{StaticResource WindowControlButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeButton"
                            Content="□"
                            ToolTip="Maximize"
                            Style="{StaticResource WindowControlButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click" />
                    <Button Content="✕"
                            ToolTip="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C42B1C" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="#13161B">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid Margin="11,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⌕"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="SearchBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextBrush}"
                                             CaretBrush="{StaticResource TextBrush}"
                                             FontSize="13"
                                             VerticalContentAlignment="Center"
                                             TextChanged="SearchBox_TextChanged" />
                                    <TextBlock x:Name="SearchPlaceholder"
                                               Text="Search projects"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Button Grid.Row="2"
                                Content="＋ Add Project"
                                HorizontalContentAlignment="Left"
                                Padding="13,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddProjectButton_Click" />

                        <ListBox x:Name="ProjectsList"
                                 Grid.Row="4"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ProjectsList_SelectionChanged"
                                 MouseDoubleClick="ProjectsList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Padding" Value="12,11" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#181D23" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1A2635" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2D527C" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FolderPath}"
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="30,28,30,24">
                    <Grid x:Name="DetailsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ProjectNameText"
                                   Grid.Row="0"
                                   FontSize="24"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="ProjectPathText"
                                   Grid.Row="1"
                                   Margin="0,7,0,26"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />

                        <Border Grid.Row="2"
                                Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,0,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Codex home"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13" />
                                <TextBlock x:Name="CodexHomeText"
                                           Grid.Row="0" Grid.Column="1"
                                           FontSize="13"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="VS Code data"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13" />
                                <TextBlock x:Name="VsCodeDataText"
                                           Grid.Row="2" Grid.Column="1"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <WrapPanel Grid.Row="3">
                            <Button Content="Open in VS Code"
                                    Margin="0,0,9,0"
                                    Padding="20,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OpenSelectedButton_Click" />
                            <Button Content="Open Folder"
                                    Margin="0,0,9,0"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Click="OpenFolderButton_Click" />
                            <Button Content="Rename"
                                    Margin="0,0,9,0"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Click="RenameButton_Click" />
                            <Button Content="Remove"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="RemoveButton_Click" />
                        </WrapPanel>

                        <Border Grid.Row="5"
                                Background="#12151A"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot"
                                             Width="8" Height="8"
                                             Fill="#57C58E"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusText"
                                               Text="Ready"
                                               Margin="8,0,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="LastOpenedText"
                                           Grid.Column="1"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="EmptyState"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="No project selected"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Add or select a project to continue."
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Background="#12151A">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ProjectCountText"
                           Margin="16,0,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Margin="0,0,9,0"
                            Style="{StaticResource BaseButtonStyle}"
                            Click="RefreshButton_Click" />
                    <Button Content="Open Selected"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OpenSelectedButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
